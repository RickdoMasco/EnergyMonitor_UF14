<?xml version="1.0" encoding="UTF-8"?>

<!--
Configurazione log del backend: stesso formato di default di Spring Boot, ma messaggio (%mask)
e stack trace (%maskEx) oscurano password, token e chiavi API.
-->
<configuration>
	<conversionRule conversionWord="mask"
			class="it.energymonitor.backend.logging.SensitiveDataMaskingConverter"/>
	<conversionRule conversionWord="maskEx"
			class="it.energymonitor.backend.logging.SensitiveThrowableMaskingConverter"/>

	<!-- Le {} vuote dopo %mask(...) servono: senza, Logback stampa come testo il convertitore successivo -->
	<property name="CONSOLE_LOG_PATTERN"
			value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}){} %clr(${PID:-}){magenta} %clr(--- [%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %mask(%m){}%n%maskEx"/>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>
